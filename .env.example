# Offer Studio — variáveis de ambiente.
# O arquivo .env é gerado automaticamente por `npm run setup` com segredos aleatórios.
# Não é preciso editar nada para usar no seu Mac.

# Porta do painel (http://localhost:3000)
PORT=3000
# Endereço público do painel (usado pelo login)
BETTER_AUTH_URL=http://localhost:3000
# Segredo das sessões de login (32+ caracteres aleatórios)
BETTER_AUTH_SECRET=

# Banco de dados PostgreSQL embutido (roda dentro da pasta data/postgres)
PG_PORT=5433
PG_USER=offerstudio
PG_PASSWORD=
DATABASE_URL=postgresql://offerstudio:SENHA@127.0.0.1:5433/offerstudio

# Chave para criptografar tokens de pixels (base64 de 32 bytes)
APP_ENCRYPTION_KEY=

# Pasta onde ficam banco, arquivos e backups (relativa ao projeto ou absoluta)
DATA_DIR=./data
