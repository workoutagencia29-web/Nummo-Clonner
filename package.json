  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/css-tree": "3.2.0",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "3.4.0",
