    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@uiw/react-codemirror": "4.25.12",
    "better-auth": "1.7.6",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "css-tree": "3.2.1",
    "date-fns": "4.4.0",
    "domhandler": "5.0.3",
    "dotenv": "18.0.4",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "grapesjs": "0.23.6",
    "iconv-lite": "0.7.3",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "p-limit": "7.3.3",
    "parse5": "7.3.0",
    "pg": "8.23.0",
