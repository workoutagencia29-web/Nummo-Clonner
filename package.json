{
  "name": "offer-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/run.ts dev",
    "build": "prisma generate && next build",
    "start": "tsx scripts/run.ts prod",
    "lint": "biome check",
    "format": "biome check --write",
    "setup": "tsx scripts/setup.ts",
    "redefinir-senha": "tsx scripts/reset-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run e2e",
    "db:migrate": "tsx scripts/with-db.ts -- prisma migrate dev",
    "db:studio": "tsx scripts/with-db.ts -- prisma studio",
    "postinstall": "prisma generate",
    "pree2e": "playwright install chromium"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
