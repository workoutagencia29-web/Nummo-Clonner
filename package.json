    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "srcset": "5.0.3",
    "tailwind-merge": "3.7.0",
